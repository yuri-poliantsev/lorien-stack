# Copy to .env, fill in, then export it before you start either process:
#   set -a; . ./.env; set +a
# Keep .env out of git. Never commit a real token or sender key.
# Setup guide: docs/live.md

# Absolute path to the Grok Bot data root that holds agents/ and agent-transcripts/.
AGENT_DATA=

# Bearer token that POST /api/prompt requires. Generate one: openssl rand -hex 24
# GATEWAY_CLIENT_TOKEN and VITE_GATEWAY_TOKEN must hold the same string.
# When they differ, every wake returns 401.
GATEWAY_CLIENT_TOKEN=
VITE_GATEWAY_TOKEN=

# Webhook routine that wakes a bot. URL is safe to share. The key is not.
# The key stays in the gateway process and never reaches the browser.
WEBHOOK_URL=
WEBHOOK_SENDER_KEY=
