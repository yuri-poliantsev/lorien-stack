{
  "name": "lorien-stack",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test --workspaces",
    "docs:smoke": "node scripts/docs-smoke.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "gateway": "node --disable-warning=ExperimentalWarning --experimental-strip-types apps/gateway/src/main.ts",
    "capture": "node scripts/capture/capture.mjs"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "playwright": "1.62.1",
    "typescript": "^5.8.3"
  }
}
