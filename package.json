{
  "name": "lorien-stack",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test -w packages/contracts",
    "docs:smoke": "node scripts/docs-smoke.mjs",
    "typecheck": "npm run typecheck -w packages/contracts",
    "gateway": "node --disable-warning=ExperimentalWarning --experimental-strip-types apps/gateway/src/main.ts"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "typescript": "^5.8.3"
  }
}
